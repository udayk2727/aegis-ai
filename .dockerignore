# Build context for the demo images. Everything here is excluded so that
# credentials, local manifests, host virtual environments, dependency folders,
# and build output never reach the image build.

# Version control and CI configuration
.git
.github

# Host environments and caches
.venv
venv
env
ENV
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Local generated data: trusted-baseline manifests and analysis charts
local
artifacts

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets
credentials.json
*.kdbx
wallet
tnsnames.ora
sqlnet.ora

# Frontend dependencies and build output. The frontend image installs and
# builds inside its own stage.
frontend/node_modules
frontend/dist
frontend/build

# Documentation and deployment notes are not needed to run the images
docs
infrastructure
README.md
CLAUDE.md

# Logs and temporary files
*.log
logs
tmp
temp
*.tmp
*.bak
*.swp
